# Copie para .env e substitua localmente. Nunca coloque valores reais no Git.
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_TOKEN=
ZABBIX_TIMEOUT_S=15

RAVICOR_URL=https://ravi.example.com/api/api.php
RAVICOR_TOKEN=
RAVICOR_TIMEOUT_S=15

GEMINI_API_KEY=
NOC_AI_MODEL=gemini-3.5-flash-lite
NOC_AI_THINKING=minimal
GEMINI_TIMEOUT_S=45
NOC_AI_REDACT_DATA=true

# Prefira credenciais distintas por origem. WEBHOOK_TOKEN é fallback legado.
RAVI_WEBHOOK_TOKEN=
ZABBIX_WEBHOOK_TOKEN=
WEBHOOK_TOKEN=
NOC_WEBHOOK_MAX_BODY_BYTES=1048576
NOC_WEBHOOK_URL=http://127.0.0.1:8089/zabbix/webhook

MODO_TESTE=true
NOC_USAR_IA=true
NOC_AI_AUTO_SEND=false
NOC_AI_IN_TEST_MODE=false
NOC_MENSAGEIRO=telegram
MESSAGING_TIMEOUT_S=20
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NOC_ZABBIX_POLL_INTERVAL_S=30
NOC_ZABBIX_INITIAL_LOOKBACK_MIN=5
NOC_ZABBIX_SEVERIDADE_MINIMA=2
